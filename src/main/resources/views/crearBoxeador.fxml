<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.juegoboxeo.controller.CrearBoxeadorController"
      spacing="15"
      alignment="CENTER"
      styleClass="root">

    <Label text="Crear Boxeador Jugador" styleClass="titulo"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="labelsInfo"/>
        <TextField fx:id="nombreField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="inputs" promptText="Nombre de su personaje"/>

        <Label text="Año nacimiento:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="labelsInfo"/>
        <TextField fx:id="anyoField" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="inputs" promptText="2000"/>

        <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="labelsInfo"/>
        <TextField fx:id="descripcionField" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="inputs" promptText="Descripción de su personaje"/>

        <Label text="Vida:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="labelsInfo"/>
        <TextField fx:id="vidaField" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="inputs" promptText="Min: 1 - Max: 300"/>

        <Label text="Stamina:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="labelsInfo"/>
        <TextField fx:id="staminaField" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="inputs" promptText="Min: 1 - Max: 300"/>

    </GridPane>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Volver" onAction="#volverAEscogerPartida" styleClass="botonVolver"/>
        <Button text="Crear Boxeador" onAction="#crearBoxeador" styleClass="botonCrear"/>
    </HBox>
</VBox>