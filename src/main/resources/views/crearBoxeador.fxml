<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.juegoboxeo.controller.CrearBoxeadorController"
      spacing="15"
      alignment="CENTER"
      styleClass="root">

    <Label text="Crear Boxeador Jugador"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Año nacimiento:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="anyoField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="descripcionField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Vida:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="vidaField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Stamina:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="staminaField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Crear Boxeador" onAction="#crearBoxeador"/>

</VBox>